{
  "name": "TubeFox",
  "description": "Key-free YouTube client with local subscriptions, history and favorites.",
  "version": "1.0.0",
  "type": "privileged",
  "launch_path": "/index.html",
  "icons": { "60": "/icons/60.png", "128": "/icons/128.png" },
  "developer": { "name": "TubeFox" },
  "orientation": ["portrait-primary", "landscape-primary"],
  "default_locale": "en",
  "permissions": {
    "systemXHR": { "description": "Reads public video data from open YouTube front-end APIs" }
  }
}
